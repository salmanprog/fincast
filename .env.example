# Database
DATABASE_URL="mysql://user:password@localhost:3306/fincast"

# JWT (users + admin API auth)
JWT_SECRET="change-me"

# NextAuth (legacy — was used for Google Calendar booking; optional if unused)
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (legacy — was used for Google Calendar booking; optional if unused)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALENDAR_ID="primary"
GOOGLE_CALENDAR_TIMEZONE="America/New_York"

# Square
# SQUARE_ACCESS_TOKEN = Sandbox Access token (sandbox-sq0atb-...) — server only, for charging cards
# SQUARE_APPLICATION_ID = Sandbox Application ID (sandbox-sq0idb-...) — used by Web Payments card form
SQUARE_ACCESS_TOKEN=""
SQUARE_APPLICATION_ID=""
NEXT_PUBLIC_SQUARE_APPLICATION_ID=""
SQUARE_LOCATION_ID=""
SQUARE_ENVIRONMENT="sandbox"
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_NOTIFICATION_URL="http://localhost:3000/api/webhooks/square"

# App URL (Square checkout redirect)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Calendly — public scheduling URL (safe for frontend; no private API token)
NEXT_PUBLIC_CALENDLY_BOOKING_URL=https://calendly.com/production8421/30min

# Optional server-only Calendly PAT for webhook/API integration (never expose to browser)
# CALENDLY_TOKEN=
