# Database
DATABASE_URL="mysql://user:password@localhost:3306/fincast"

# JWT (users + admin API auth)
JWT_SECRET="change-me"

# NextAuth (legacy — was used for Google Calendar booking; optional if unused)
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (legacy — was used for Google Calendar booking; optional if unused)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALENDAR_ID="primary"
GOOGLE_CALENDAR_TIMEZONE="America/New_York"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""

# App URL (Stripe redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Calendly — public scheduling URL (safe for frontend; no private API token)
NEXT_PUBLIC_CALENDLY_BOOKING_URL=https://calendly.com/production8421/30min

# Optional server-only Calendly PAT for webhook/API integration (never expose to browser)
# CALENDLY_TOKEN=
